# Copy this file to .env and fill in the values
# .env is gitignored and will NOT be committed

# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-openssl-rand-hex-64

# Override if needed (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Google Sign-In OAuth client ID
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Frontend build-time Google Identity Services client ID
# For Docker Compose frontend builds, set this to the same value as GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Resend SMTP — get API key from https://resend.com
# Without this, invitation emails are skipped (invite link printed to backend log instead)
RESEND_API_KEY=
